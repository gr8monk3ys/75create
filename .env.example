# Copy to .env.local and fill in what you use. Every variable is optional:
# with none set, 75 Create runs entirely in the browser (local-first).

# Absolute origin of the deployed site, for Open Graph / Twitter image URLs.
NEXT_PUBLIC_SITE_URL=https://75create.example.com

# Supabase (real auth, cross-device sync, server reminders). Leave both empty
# for the local-only build; the Supabase SDK is then never downloaded.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push reminders: the VAPID public key (base64url). Pair it with the
# send-push function's VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT
# secrets (see README "Reminders").
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Where client errors are POSTed as JSON (any collector). Empty = console only.
NEXT_PUBLIC_ERROR_ENDPOINT=
